{
  "name": "complejo-micar",
  "version": "1.0.0",
  "description": "Sitio web oficial de Cabañas MICAR",
  "private": true,
  "scripts": {
    "gallery": "node scripts/update-gallery.js && node scripts/responsive-images.js",
    "reviews": "node scripts/update-reviews.js",
    "convert-webp": "node scripts/convert-to-webp.js && node scripts/responsive-images.js",
    "images": "node scripts/responsive-images.js",
    "fonts": "node scripts/vendor-fonts.js",
    "build": "node scripts/vendor-fonts.js && node scripts/responsive-images.js && node scripts/build.js",
    "preview": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "audit:lighthouse": "node scripts/audit.mjs",
    "test:browser": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "esbuild": "^0.28.2",
    "lighthouse": "13.5.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
